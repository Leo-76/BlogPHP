{
    "name": "stanley/blogphp-symfony",
    "description": "BlogPHP avec composants Symfony — HttpFoundation, Routing, Validator, Cache, Mailer, Security",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "symfony/http-foundation":  "^6.4",
        "symfony/routing":          "^6.4",
        "symfony/validator":        "^6.4",
        "symfony/cache":            "^6.4",
        "symfony/mailer":           "^6.4",
        "symfony/security-core":    "^6.4",
        "symfony/password-hasher":  "^6.4",
        "symfony/translation":      "^6.4",
        "symfony/property-access":  "^6.4",
        "doctrine/dbal":            "^3.0",
        "vlucas/phpdotenv":         "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve":   "php -S localhost:8080 router.php",
        "test":    "phpunit --testdox",
        "migrate": "php bin/console migrate"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
